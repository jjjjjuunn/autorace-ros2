<?xml version="1.0"?>
<robot name="track">
  <link name="world"/>

  <link name="track">
    <visual>
      <geometry>
        <!-- 변환한 파일 사용 -->
        <mesh filename="file:///home/junwon/autorace/doro2_fixed.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="track_gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="world_track" type="fixed">
    <parent link="world"/>
    <child link="track"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>