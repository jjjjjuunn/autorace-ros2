<?xml version="1.0"?>
<robot name="turtlebot3_burger">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.150 0.150 0.060"/>
      </geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <material name="burger_red">
        <color rgba="0.95 0.04 0.08 1.0"/>
      </material>
    </visual>
  </link>

  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="0.015" length="0.030"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="lidar_black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
  </joint>

  <!-- 카메라 링크 추가 -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="camera_blue">
        <color rgba="0.0 0.0 1.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 카메라 조인트 추가 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- 앞쪽, 약간 아래를 향하도록 -->
    <origin xyz="0.05 0 0.05" rpy="0 0.3 0"/>
  </joint>
</robot>